(max_views_velocity_raw=1.2, max_compares_velocity_raw=1.0) Tj
T*
() Tj
T*
(Step A1: velocity raw values) Tj
T*
(views_velocity_raw = max\(0, \(\(views_recent + s\)/\(views_previous + s\)\) - 1\)) Tj
T*
(= max\(0, \(\(1200+5\)/\(800+5\)\) - 1\)) Tj
T*
(= max\(0, \(1205/805\) - 1\)) Tj
T*
(= max\(0, 1.496894410 - 1\)) Tj
T*
(= 0.496894410) Tj
T*
() Tj
T*
(compares_velocity_raw = max\(0, \(\(compares_recent + s\)/\(compares_previous + s\)\) - 1\)) Tj
T*
(= max\(0, \(\(240+5\)/\(160+5\)\) - 1\)) Tj
T*
(= max\(0, 1.484848485 - 1\)) Tj
