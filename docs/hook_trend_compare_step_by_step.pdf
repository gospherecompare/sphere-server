T*
(norm_views = 100*1200/1500 = 80.000000) Tj
T*
(norm_compares = 100*240/300 = 80.000000) Tj
T*
(norm_wishlist = 100*300/500 = 60.000000) Tj
T*
(norm_views_velocity = 100*0.496894410/1.2 = 41.407867) Tj
T*
(norm_compares_velocity = 100*0.484848485/1.0 = 48.484848) Tj
T*
() Tj
T*
(Step A3: buyer intent) Tj
T*
(buyer_intent = clamp\(0.55*norm_views + 0.30*norm_compares + 0.15*norm_wishlist, 0, 100\)) Tj
T*
(= clamp\(0.55*80.000000 + 0.30*80.000000 + 0.15*60.000000, 0, 100\)) Tj
T*
(= clamp\(44.000000 + 24.000000 + 9.000000, 0, 100\)) Tj
T*
(= 77.000000) Tj
T*
() Tj
T*
(Step A4: trend velocity) Tj
T*
(trend_velocity = clamp\(0.70*norm_views_velocity + 0.30*norm_compares_velocity, 0, 100\)) Tj
T*
(= clamp\(0.70*41.407867 + 0.30*48.484848, 0, 100\)) Tj
T*
(= clamp\(28.985507 + 14.545455, 0, 100\)) Tj
T*
(= 43.530962) Tj
T*
() Tj
T*
(Step A5: freshness) Tj
T*
(freshness = clamp\(100 * exp\(-age_days/tau\), 0, 100\)) Tj
