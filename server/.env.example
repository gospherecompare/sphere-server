# Public API response encoding
# Keep local development readable; set true in the production environment.
PUBLIC_API_BASE64=false

# Automatic TV discovery and generation. The worker runs immediately at startup,
# then every 12 hours unless disabled.
TV_GENERATION_CRON_ENABLED=true
TV_GENERATION_CRON_INTERVAL_MS=43200000
TV_GENERATION_MAX_GEMINI_CALLS=12
TV_GENERATION_MAX_SUCCESSFUL_TVS=5

# Official TV/appliance image ingestion (Cloudinary unsigned upload preset)
CLOUDINARY_CLOUD_NAME=dyksxeshr
CLOUDINARY_PRESET_APPLIANCE=sphere_appliance

# Backward-compatible generic preset name

# Brand image uploads
CLOUDINARY_PRESET_BRANDS=sphere_brands


# Cloudinary credentials for client_1 (Vite)
# Replace the placeholder values with your Cloudinary credentials.


JWT_SECRET=smartarena_secret_key_25

# ===== APP =====
NODE_ENV=development
PORT=5000

# ===== CORS =====
ALLOWED_ORIGINS=*

